{
  "name": "termx",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform terminal emulator for running many Claude Code sessions at once",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jibaru/termx.git"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @termx/desktop tauri dev",
    "build": "pnpm --filter @termx/desktop build",
    "typecheck": "pnpm --filter @termx/desktop typecheck",
    "tauri": "pnpm --filter @termx/desktop tauri",
    "lint": "pnpm --filter @termx/desktop lint && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
